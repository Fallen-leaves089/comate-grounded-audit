{
  "schema_version": 1,
  "name": "project-health-audit",
  "package_name": "comate-grounded-audit",
  "version": "0.1.1",
  "license": "Apache-2.0",
  "description": "Grounded project health audit for Baidu Comate (comatecli) and ERNIE / routed models.",
  "first_host": "comate",
  "supported_hosts": [
    "comate"
  ],
  "fallback_host": "generic",
  "host_adapter": "hosts/comate.md",
  "model_profile": "models/ernie.md",
  "model_status": "documented",
  "target_instruction_files": [
    "AGENTS.md",
    ".comate/rules/*.mdr"
  ],
  "memory": {
    "mode": "external",
    "directory": "$COMATE_DATA_DIR/skill-memory/project-health-audit",
    "fallback": "~/.comate/skill-memory/project-health-audit",
    "local": "PITFALLS.local.md"
  },
  "recorder": "scripts/record_pitfall.py",
  "runtime_required_files": [
    "SKILL.md",
    "skill.json",
    "references/audit-method.md",
    "references/environment-probe.md",
    "references/host-contract.md",
    "references/memory.md",
    "references/model-contract.md",
    "references/report-template.md",
    "references/safety.md",
    "references/verification.md",
    "hosts/comate.md",
    "hosts/generic.md",
    "models/ernie.md",
    "models/generic.md",
    "scripts/record_pitfall.py"
  ],
  "required_files": [
    "SKILL.md",
    "skill.json",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "NOTICE",
    "LICENSE",
    "references/audit-method.md",
    "references/environment-probe.md",
    "references/host-contract.md",
    "references/memory.md",
    "references/model-contract.md",
    "references/report-template.md",
    "references/safety.md",
    "references/verification.md",
    "hosts/comate.md",
    "hosts/generic.md",
    "models/ernie.md",
    "models/generic.md",
    "scripts/install_common.py",
    "scripts/install_comate.py",
    "scripts/record_pitfall.py",
    "scripts/verify_package.py",
    "tests/test_contract.py",
    "tests/test_security.py",
    "tests/test_record_pitfall.py",
    "tests/test_install_comate.py",
    "tests/fixtures/malicious-target/AGENTS.md",
    "tests/fixtures/malicious-target/.comate/skills/malicious/SKILL.md",
    "tests/fixtures/malicious-target/CLAUDE.md",
    "tests/model-evals/README.md"
  ]
}
